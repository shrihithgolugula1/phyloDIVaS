      "post_job_actions": {},
      "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_awk_tool/9.11+galaxy0",
      "tool_state": "{\"infile\":{\"__class__\":\"ConnectedValue\"},\"code\":\"BEGIN { FS = OFS = \\\"\\\\t\\\" }\\nNR == 1 {\\n  species_start = 1\\n  species_end = NF\\n  parent_col = 0\\n  for (i = 1; i <= NF; i++) {\\n    header = tolower($i)\\n    gsub(/^[[:space:]]+|[[:space:]]+$/, \\\"\\\", header)\\n    if (header == \\\"gene tree parent clade\\\") parent_col = i\\n    if (header == \\\"hog\\\" || header == \\\"orthogroup\\\" || header == \\\"og\\\" || header == \\\"gene tree parent clade\\\") species_start = i + 1\\n  }\\n  next\\n}\\n{\\n  hog = $1\\n  parent = parent_col ? tolower($(parent_col)) : \\\"\\\"\\n  if (parent_col && parent != \\\"n0\\\") next\\n  if (!parent_col && tolower(hog) !~ /^n0([.]|$)/) next\\n  valid = 1\\n  for (i = species_start; i <= species_end; i++) {\\n    gene = $i\\n    gsub(/^[[:space:]]+|[[:space:]]+$/, \\\"\\\", gene)\\n    if (gene == \\\"\\\" || gene == \\\"-\\\" || gene == \\\"0\\\" || index(gene, \\\",\\\") > 0) { valid = 0; break }\\n  }\\n  if (valid) {\\n    for (i = species_start; i <= species_end; i++) {\\n      gene = $i\\n      gsub(/^[[:space:]]+|[[:space:]]+$/, \\\"\\\", gene)\\n      print hog, gene\\n    }\\n  }\\n}\",\"variables\":[],\"__page__\":0,\"__rerun_remap_job_id__\":null}",
      "tool_uuid": null,
      "tool_version": "9.11+galaxy0",

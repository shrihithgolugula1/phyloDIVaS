@{
    ViewData["Title"] = "History";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="box">
    <h2>History</h2>

    <div class="row-custom">
        <span>Recent Search 1</span>
        <span>04/16/2025</span>
    </div>
    <div class="row-custom">
        <span>Recent Search 2</span>
        <span>04/15/2025</span>
    </div>
    <div class="row-custom">
        <span>Recent Search 3</span>
        <span>04/14/2025</span>
    </div>
    <div class="row-custom">
        <span>Recent Search 4</span>
        <span>04/13/2025</span>
    </div>
</div>

<style>
    body {
        background-color: #f4f4f4;
        margin: 0;
        font-family: 'Roboto', sans-serif;
        color: #333;
    }

    .box {
        max-width: 800px;
        margin: 60px auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

        .box h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 32px;
            font-weight: 700;
            color: #333;
        }

    .row-custom {
        display: flex;
        justify-content: space-between;
        padding: 18px 20px;
        border-bottom: 1px solid #d1d1d1;
        font-size: 18px;
        color: #444;
        font-weight: 500;
        margin-bottom: 12px;
        background-color: #d4d4d4;
        border-radius: 6px;
        transition: background-color 0.2s ease;
    }

        .row-custom:last-child {
            border-bottom: none;
        }

        .row-custom:hover {
            background-color: #c0c0c0;
            cursor: pointer;
        }

        .row-custom span {
            margin: 0 10px;
            font-family: 'Arial', sans-serif;
        }
</style>

@{
    Layout = "_Layout";
    ViewData["Title"] = "About Us";
}
    <style>
        body {
            background-color: #f4f4f4;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-container {
            max-width: 800px;
            margin: 60px auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 40px;
        }

        .page-title {
            font-size: 2rem;
            font-weight: bold;
            text-align: center;
            margin-bottom: 40px;
        }

        .section {
            background-color: #eaeaea;
            border-radius: 12px;
            padding: 25px 30px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #343a40;
            text-align: center;
        }

        .contact-info p {
            margin: 5px 0;
            font-size: 1rem;
            color: #555;
        }
    </style>

<body>
    <div class="main-container">
        <div class="page-title">About Us</div>

        <div class="section">
            <div class="section-title">PhyloDivas</div>
            <p class="text-center">Welcome to PhyloDivas. Our goal is to make evolutionary analysis accessible and insightful for all researchers and students working with gene data across species.</p>
        </div>

        <div class="section text-center">
            <div class="section-title">PhyloDivas</div>
            <div class="contact-info">
                <p><strong>Project Lead:</strong> Rob Kulathinal</p>
                <p><strong>Email:</strong> robkulathinal@temple.edu</p>
                <p><strong>Location:</strong> Temple University</p>
            </div>
        </div>
    </div>
</body>

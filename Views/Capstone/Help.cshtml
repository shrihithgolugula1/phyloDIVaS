@{
    ViewData["Title"] = "Support";
    Layout = "_Layout";
}

<style>
    body {
        background-color: #f4f4f4;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-5 bg-light p-4 rounded-4 shadow-sm">
            <h4 class="fw-bold">Frequently Asked Questions (FAQs)</h4>
            <div class="mt-3">
                <p>
                    <strong>Q: How do I create an account?</strong><br />
                    Select Register in the navigation bar, complete the form, and verify your email address.
                </p>

                <p>
                    <strong>Q: How do I reset my password?</strong><br />
                    Select Forgot Password on the sign-in page and follow the instructions sent to your registered email address.
                </p>
            </div>
        </div>

        <div class="col-md-5 bg-light p-4 rounded-4 shadow-sm">
            <h4 class="fw-bold">Technical Support</h4>
            <p class="mt-3 fw-semibold">If you're experiencing issues with the website:</p>
            <ul>
                <li>Try clearing your browser cache and cookies</li>
                <li>Make sure your browser is up to date</li>
                <li>Contact our support team if the issue persists</li>
            </ul>
        </div>
    </div>

    <div class="row justify-content-center mt-5">
        <div class="col-md-6 bg-light p-4 rounded-4 shadow-sm text-center">
            <h4 class="fw-bold">Still Need Help?</h4>
            <p class="text-muted">If you did not find an answer here, contact the phyloDIVaS team:</p>
            <div class="d-flex align-items-center justify-content-center mb-3">
                <i class="bi bi-envelope me-2 fs-5"></i>
                <span>shrihith.golugula@temple.edu</span>
            </div>
            <div class="d-flex align-items-center justify-content-center mb-3">
                <i class="bi bi-geo-alt me-2 fs-5"></i>
                <span>Temple University, Philadelphia, PA</span>
            </div>
        </div>
    </div>
</div>

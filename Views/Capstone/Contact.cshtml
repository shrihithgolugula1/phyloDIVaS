@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<style>
    body{
        background-color: #f4f4f4;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 d-flex flex-wrap gap-4">
            <div class="flex-fill bg-light rounded-4 p-4 shadow-sm" style="min-width: 300px; flex: 1;">
                <h3 class="text-center fw-bold mb-2">Reach Out to Us</h3>
                <p class="text-center text-muted mb-4">Please enter your information below to get in touch with us.</p>

                <form>
                    <div class="mb-3 d-flex justify-content-between">
                        <label class="me-3" style="min-width: 100px;">First Name:</label>
                        <input type="text" class="form-control bg-white" />
                    </div>
                    <div class="mb-3 d-flex justify-content-between">
                        <label class="me-3" style="min-width: 100px;">Last Name:</label>
                        <input type="text" class="form-control bg-white" />
                    </div>
                    <div class="mb-3 d-flex justify-content-between">
                        <label class="me-3" style="min-width: 100px;">Email:</label>
                        <input type="email" class="form-control bg-white" />
                    </div>
                    <div class="mb-3 d-flex justify-content-between">
                        <label class="me-3" style="min-width: 100px;">Phone:</label>
                        <input type="tel" class="form-control bg-white" />
                    </div>
                    <div class="mb-3 d-flex justify-content-between">
                        <label class="me-3" style="min-width: 100px;">Subject:</label>
                        <input type="text" class="form-control bg-white" />
                    </div>
                    <div class="mb-3 d-flex flex-column">
                        <label class="mb-1">Message:</label>
                        <textarea rows="4" class="form-control bg-white"></textarea>
                    </div>
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-secondary px-4">Submit</button>
                    </div>
                </form>
            </div>

            <div class="flex-fill bg-light rounded-4 p-4 shadow-sm" style="min-width: 280px; flex: 1;">
                <h3 class="text-center fw-bold mb-2">Contact Information</h3>
                <p class="text-center text-muted mb-4">
                    Contact the phyloDIVaS team by email.
                </p>

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-envelope me-3 fs-5"></i>
                    <span>shrihith.golugula@temple.edu</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-geo-alt me-3 fs-5"></i>
                    <span>Temple University, Philadelphia, PA</span>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us - Get in Touch</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <style>
        body {
            background-color: #f4f4f4;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-container {
            max-width: 1100px; /* Increased width */
            margin: 60px auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 40px;
        }

        .page-title {
            font-size: 2rem;
            font-weight: bold;
            text-align: center;
            margin-bottom: 40px;
        }

        .section {
            background-color: #eaeaea;
            border-radius: 12px;
            padding: 25px 30px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #343a40;
            text-align: center;
        }

        .contact-info p {
            margin: 5px 0;
            font-size: 1rem;
            color: #555;
        }

        ul {
            padding-left: 1.2rem;
        }

        .contact-form label {
            font-weight: bold;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .contact-form textarea {
            height: 150px;
        }

        .submit-btn {
            display: inline-block;
            padding: 10px 20px;
            font-weight: bold;
            background-color: #6c757d;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

            .submit-btn:hover {
                background-color: #5a6268; 
            }


    </style>
</head>
<body>
    <div class="main-container">
        <div class="page-title">Contact Us - Get in Touch</div>

        <div class="row">
            <div class="col-md-8">
                <div class="section">
                    <div class="section-title">Reach Out to Us</div>
                    <p><strong>Please enter your information below to get in touch with us:</strong></p>
                    <form class="contact-form">
                        <div class="mb-3">
                            <label for="first-name" class="form-label">First Name</label>
                            <input type="text" id="first-name" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="last-name" class="form-label">Last Name</label>
                            <input type="text" id="last-name" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" id="email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="confirm-email" class="form-label">Confirm Email</label>
                            <input type="email" id="confirm-email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="tel" id="phone" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" id="subject" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea id="message" class="form-control"></textarea>
                        </div>
                        <button type="submit" class="submit-btn">Submit</button>
                    </form>
                </div>
            </div>

            <div class="col-md-4">
                <div class="section">
                    <div class="section-title">Our Contact Info</div>
                    <p>Feel free to reach out to us through the contact information below:</p>
                    <div class="contact-info">
                        <p><strong>Phone:</strong> (123) 456-7890</p>
                        <p><strong>Email:</strong> support@example.com</p>
                        <p><strong>Location:</strong> 123 Medical St, Cityville, Country</p>
                        <p><strong>Business Hours:</strong> Mon–Fri, 9am–5pm</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

﻿@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Bundle JS (for modals and components) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .navbar {
            background: linear-gradient(to bottom, rgba(33, 37, 41, 0.60), rgba(33, 37, 41, 0.55), rgba(33, 37, 41, 0.30), rgba(33, 37, 41, 0));
            border-bottom: none;
            padding-bottom: 2%;
            transition: background 0.3s ease;
            position: sticky;
            top: 0;
            z-index: 100;
        }
                /* VARIABLES */
        :root {
            --font-scale: 1;
            --high-contrast-bg: #000;
            --high-contrast-text: #fff;
            --dark-bg: #1a1a1a;
            --dark-text: #e6e6e6;
        }

        /* BUTTON */
        .accessibility-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            padding: 14px 18px;
            background: #4a4a4a;
            color: white;
            border-radius: 50%;
            border: none;
            font-size: 1.6rem;
            cursor: pointer;
            z-index: 2000;
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
            transition: transform 0.2s ease;
        }

        .accessibility-btn:hover {
            transform: scale(1.15);
        }

        /* PANEL */
        .accessibility-panel {
            position: fixed;
            bottom: 90px;
            right: 25px;
            width: 310px;
            background: white;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 8px 28px rgba(0,0,0,0.25);
            display: none;
            z-index: 2001;
            animation: fadeSlide 0.3s ease;
        }

        @@keyframes fadeSlide {
            0% { opacity: 0; transform: translateY(15px); }
            100% { opacity: 1; transform: translateY(0); }
        }



        .panel-title {
            font-weight: 700;
            text-align: center;
            margin-bottom: 18px;
        }

        .setting-group {
            margin-bottom: 18px;
        }

        .setting-label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
        }

        .setting-controls {
            display: flex;
            gap: 10px;
        }

        .acc-btn {
            flex: 1;
            padding: 8px 10px;
            border: 1px solid #ccc;
            background: #f8f8f8;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.2s ease;
            font-weight: 500;
        }

        .acc-btn:hover {
            background: #ededed;
        }

        .acc-select {
            border-radius: 10px !important;
            padding: 8px !important;
        }

        /* MODES */
        body.high-contrast {
            background-color: var(--high-contrast-bg) !important;
            color: var(--high-contrast-text) !important;
        }

        body.dark-mode {
            background-color: var(--dark-bg) !important;
            color: var(--dark-text) !important;
        }

        body.reduced-motion * {
            animation: none !important;
            transition: none !important;
        }

        .alt-text-placeholder {
            padding: 20px;
            background: #fff7cc;
            border-left: 5px solid #e6c200;
            border-radius: 10px;
            margin-top: 10px;
            font-size: 1rem;
        }

    </style>

</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("HomePage", "Capstone")">[ Logo ]</a>
            <div class="collapse navbar-collapse justify-content-between">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("HomePage", "Capstone")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("AboutUs", "Capstone")">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Contact", "Capstone")">Contact</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Login", "Account")">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Logout", "Account")">LogOut</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Register", "Capstone")">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-white mt-auto pt-4 pb-2" style="background-color:#777">
        <div class="container">
            <div class="row border-top pt-3">
                <div class="col-md-4 d-flex align-items-center">
                    <img src="~/images/logo.png" alt="Logo" style="height: 60px;" class="me-2" />
                </div>

                <div class="col-md-8 text-end">
                    <p><i class="bi bi-envelope"></i> Example Email</p>
                    <p><i class="bi bi-telephone"></i> (123)-456-7890</p>
                    <p><i class="bi bi-geo-alt"></i> 1234 Address Ln.</p>
                    <small class="text-white-50">
                        <a class="text-white text-decoration-none" href="@Url.Action("PrivacyPolicy", "Capstone")">Privacy Policy</a>
                        <a style="padding-left: 2%;" class="text-white text-decoration-none" href="@Url.Action("FrequentlyAskedQuestions", "Capstone")">FAQs</a>
                        <a style="padding-left: 2%; padding-right: 2%" class="text-white text-decoration-none" href="@Url.Action("Disclaimer", "Capstone")">Disclaimer</a>
                        Copyright © 2025 - Team PhyloDIVas
                    </small>
                </div>
            </div>
        </div>
    </footer>


    <!-- Floating trigger button -->
    <button id="accessibilityToggle"
            aria-label="Open accessibility settings"
            class="accessibility-btn">
        <i class="bi bi-universal-access"></i>
    </button>

    <!-- Panel UI -->
    <div id="accessibilityPanel" class="accessibility-panel" aria-hidden="true">

        <h4 class="panel-title">Accessibility Settings</h4>

        <div class="setting-group">
            <label class="setting-label">Font Size</label>
            <div class="setting-controls">
                <button class="acc-btn" onclick="decreaseFont()">A-</button>
                <button class="acc-btn" onclick="increaseFont()">A+</button>
            </div>
        </div>

        <div class="setting-group">
            <label class="setting-label">Color Modes</label>
            <div class="setting-controls">
                <button class="acc-btn" onclick="toggleContrast()">High Contrast</button>
                <button class="acc-btn" onclick="toggleDarkMode()">Dark Mode</button>
            </div>
        </div>

        <div class="setting-group">
            <label class="setting-label">Color-Blind Presets</label>
            <select id="colorBlindSelect" class="form-select acc-select" onchange="applyColorBlindMode()">
                <option value="none">None</option>
                <option value="protanopia">Protanopia</option>
                <option value="deuteranopia">Deuteranopia</option>
                <option value="tritanopia">Tritanopia</option>
            </select>
        </div>

        <div class="setting-group">
            <label class="setting-label">Motion</label>
            <div class="setting-controls">
                <button class="acc-btn" onclick="toggleReducedMotion()">Reduce Motion</button>
            </div>
        </div>

        <div class="setting-group">
            <label class="setting-label">Alt-Text Mode</label>
            <div class="setting-controls">
                <button class="acc-btn" onclick="toggleAltTextMode()">Enable Alt-Text Mode</button>
            </div>
        </div>

    </div>

    <script>
        // Toggle panel open/close
        document.getElementById("accessibilityToggle").onclick = function () {
            const panel = document.getElementById("accessibilityPanel");
            panel.style.display = panel.style.display === "block" ? "none" : "block";
        };

        function increaseFont() {
            let current = parseFloat(getComputedStyle(document.documentElement).fontSize);
            document.documentElement.style.fontSize = (current + 1) + "px";
        }

        function decreaseFont() {
            let current = parseFloat(getComputedStyle(document.documentElement).fontSize);
            if (current > 10) {
                document.documentElement.style.fontSize = (current - 1) + "px";
            }
        }

        function toggleContrast() {
            document.body.classList.toggle("high-contrast");
        }

        function toggleDarkMode() {
            document.body.classList.toggle("dark-mode");
        }

        function applyColorBlindMode() {
            document.body.classList.remove("cb-protanopia", "cb-deuteranopia", "cb-tritanopia");

            const mode = document.getElementById("colorBlindSelect").value;
            if (mode !== "none") {
                document.body.classList.add("cb-" + mode);
            }
        }

        function toggleReducedMotion() {
            document.body.classList.toggle("reduced-motion");
        }

        function toggleAltTextMode() {
            document.querySelectorAll("img, canvas, svg").forEach(el => {
                if (el.dataset.altReplaced) return;

                const altText = el.alt || "This visual content is described verbally for accessibility.";
                const box = document.createElement("div");
                box.className = "alt-text-placeholder";
                box.innerText = altText;

                el.style.display = "none";
                el.insertAdjacentElement("afterend", box);

                el.dataset.altReplaced = "true";
            });
        }
    </script>

    <script src="~/src/Components/Accessibility/accessibility.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
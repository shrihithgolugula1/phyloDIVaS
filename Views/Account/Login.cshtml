@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />


@model CapstoneDesign.Models.LoginViewModel

<div class="box">
    <h2>PhyloDIVas</h2>

    <form id="frmLogin" asp-controller="Account" asp-action="LoginSubmit" method="POST">
        <div class="form-group d-flex align-items-center mb-3">
            <label for="username" class="me-3" style="min-width: 100px;">Username:</label>
            <input type="text" asp-for="UserName" class="form-control form-control-sm flex-grow-1" id="username" />
        </div>

        <div class="form-group d-flex align-items-center mb-4">
            <label for="password" class="me-3" style="min-width: 100px;">Password:</label>
            <input type="password" asp-for="Password" class="form-control form-control-sm flex-grow-1" id="password" />
        </div>

        <div class="text-center">
            <button class="btn btn-secondary px-4 py-2" type="submit">Login</button>
        </div>
    </form>

</div>

<style>
    body {
        background-color: #f4f4f4;
        margin: 0;
        font-family: 'Roboto', sans-serif;
        color: #333;
    }

    .box {
        max-width: 500px;
        margin: 80px auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

        .box h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 32px;
            font-weight: 700;
            color: #333;
        }

    label {
        font-weight: 500;
        color: #444;
    }

    input.form-control {
        max-width: 300px;
    }

    .btn-secondary {
        background-color: #b0b0b0;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #999999;
        }
</style>
